# Streamlit Community Cloud: paste these into App settings -> Secrets (never commit a real key).
# Locally you can instead copy .env.example to .env.
GEMINI_API_KEY = ""
# GROQ_API_KEY = ""            # optional fallback provider
LLM_PROVIDER = "auto"
GEMINI_MODEL = "gemini-2.5-flash"

# Guardrails for a public deployment
SESSION_REQUEST_LIMIT = "20"   # natural-language requests per browser session
LLM_MIN_INTERVAL = "4"         # seconds between model calls (free tier is ~10 requests/minute)
ALLOW_REFRESH = "true"         # refresh_rules: also limited to once per session and once per hour overall
