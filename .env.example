# Copy this file to .env and fill in ONE key. Never commit .env.

# Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# auto = Gemini if its key is set, otherwise Groq. Or force: gemini | groq
LLM_PROVIDER=auto

# Optional model overrides. If a model is unavailable the app tries a few known fallbacks.
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
# Groq free tier counts prompt + max answer tokens against 8,000 tokens/minute.
GROQ_MAX_TOKENS=2000
# gpt-oss reasoning effort: low (fast, default) | medium | high
GROQ_REASONING_EFFORT=low

# ---- Agent guardrails (Assignment 4)
# Natural-language requests allowed per browser session (protects the shared free quota).
SESSION_REQUEST_LIMIT=20
# Model calls and actions allowed while answering one request.
MAX_LLM_CALLS_PER_REQUEST=8
MAX_ACTIONS_PER_PLAN=8
MAX_ACTIONS_PER_REQUEST=15
# Minimum seconds between model calls from this process (client-side rate limit).
LLM_MIN_INTERVAL=2
# refresh_rules downloads Riot's rules again; set false to disable it on a deployment.
ALLOW_REFRESH=true
REFRESH_COOLDOWN_SECONDS=3600
# Where per-session folders (decks, exports, SQLite, audit log) are created. Default: system temp dir.
# SANDBOX_ROOT=/tmp/riftbound-agent
